# Runtime output folders generated by etl.sh -- these get recreated
# automatically every time the script runs, so we don't need to
# track them in git; only the SCRIPT that generates them matters.
raw/
Transformed/
Gold/

# Test/demo output from move_files.sh -- generated when testing,
# not part of the actual project source.
json_and_CSV/
sample_input/

# Log file generated by the cron job
etl.log